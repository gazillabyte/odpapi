@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
set(_ODPAPI_MODULE_PATH "${CMAKE_MODULE_PATH}")
list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}")
find_dependency(cJSON MODULE)
set(CMAKE_MODULE_PATH "${_ODPAPI_MODULE_PATH}")
unset(_ODPAPI_MODULE_PATH)
include("${CMAKE_CURRENT_LIST_DIR}/ODPAPITargets.cmake")
check_required_components(ODPAPI)
